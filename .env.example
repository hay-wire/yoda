# Telegram bot (@BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email accounts - IMAP, up to 3 (Gmail/Outlook/Zoho or any IMAP provider).
# Use an app password, not your main password. Phase 1 fills in only
# EMAIL_1_*; Phase 2 adds the other two.
EMAIL_1_COMPANY=
EMAIL_1_CHANNEL=gmail
EMAIL_1_ACCOUNT=
EMAIL_1_APP_PASSWORD=
EMAIL_1_IMAP_HOST=imap.gmail.com

EMAIL_2_COMPANY=
EMAIL_2_CHANNEL=outlook
EMAIL_2_ACCOUNT=
EMAIL_2_APP_PASSWORD=
EMAIL_2_IMAP_HOST=outlook.office365.com

EMAIL_3_COMPANY=
EMAIL_3_CHANNEL=zoho
EMAIL_3_ACCOUNT=
EMAIL_3_APP_PASSWORD=
EMAIL_3_IMAP_HOST=imap.zoho.com

# Phase 2: WhatsApp ingestion (read-only, via Baileys). Run
# `node connectors/whatsapp_baileys.js 0` once manually to scan the QR code
# and confirm a session persists before enabling this.
WHATSAPP_ENABLED=false
# Map substrings of a WhatsApp chat id/number to a company name, as JSON,
# e.g. {"919876500001": "AcmeCo"}. Unmatched chats land under "general".
WHATSAPP_COMPANY_MAP={}

# Phase 4: WhatsApp Business API - opt-in, sending-capable, NOT wired into
# anything by default. See connectors/whatsapp_business.py before using.
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_PHONE_ID=

# Phase 2: Gemini free tier (aistudio.google.com) - used only for
# digest/summary wording over already-structured data, never raw content.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Phase 4: privacy mode. "claude" (default, Pro/Max subscription) or
# "local" (Ollama - no raw content leaves this machine, at the cost of
# classification quality).
PRIVACY_MODE=claude
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Phase 3: days without movement before an item counts as stale
STALE_DAYS=5

# Storage
EA_DB_PATH=ea.db

# Web UI (management dashboard + settings editor). Required: a real random
# secret, not a short password - it also signs session cookies. Keep
# WEBUI_HOST at 127.0.0.1 unless you've added real auth beyond this.
WEBUI_SECRET=
WEBUI_HOST=127.0.0.1
WEBUI_PORT=5000
